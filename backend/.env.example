# Eivanta backend -- environment configuration template.
#
# SEC-01: copy this file to backend/.env and fill in real values there.
# backend/.env is gitignored (see repo-root .gitignore) and must NEVER be
# committed -- every value below is a real secret or a real per-environment
# setting, not a placeholder to check in.
#
# Do not reuse the SAME JWT_SECRET / BYOK_ENCRYPTION_KEY across dev,
# staging, and production. Each environment should generate and hold its
# own values -- a shared secret means a token minted in one environment
# (or a leak from the least-protected one) is valid in all of them.

# --- Required ---

# Signs and verifies every access token and MFA challenge token (see
# backend/auth.py). No hardcoded fallback exists on purpose -- the app
# refuses to mint or verify tokens without this set. Generate a real
# random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# Encrypts every tenant's BYOK OpenAI key and MFA secret at rest (see
# backend/byok.py). Must be a valid Fernet key. No fallback exists on
# purpose -- losing/rotating this without a migration makes every
# already-encrypted value unrecoverable. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BYOK_ENCRYPTION_KEY=

# The platform's own OpenAI key, used for any tenant that hasn't
# configured their own BYOK key (see backend/byok.py's
# get_openai_api_key_for_tenant and every agents/*.py module).
OPENAI_API_KEY=

# --- Required only if you use OPS-03's backup/restore functions (backend/backup.py) ---

# Encrypts every backup of the platform database at rest (see
# backend/backup.py). Must be a valid Fernet key. Deliberately a
# SEPARATE key from BYOK_ENCRYPTION_KEY above -- a backup is a copy of
# the ENTIRE database (password hashes, refresh-token hashes, every
# tenant's BYOK ciphertext, MFA secrets, real ledger data), not just one
# tenant's BYOK key, so rotating one key must never silently affect the
# other. Lazy -- a deployment that never calls create_backup/
# restore_backup/verify_backup is never blocked by not having this set.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKUP_ENCRYPTION_KEY=

# Where backend/backup.py writes/reads encrypted backups and their
# metadata sidecars. Default: backend/backups/ (created automatically).
EIVANTA_BACKUP_DIR=

# --- Optional (real defaults already in code if unset) ---

# JWT signing algorithm. Default: HS256. Only change this if you actually
# know why -- switching families (e.g. to an RS256/asymmetric scheme)
# requires code changes beyond this env var, not just a new value here.
JWT_ALGORITHM=HS256

# Max accepted upload size (bytes) for the general CSV/ledger upload path.
# Default: 26214400 (25 MiB).
EIVANTA_MAX_UPLOAD_BYTES=26214400

# Max accepted upload size (bytes) for the Knowledge Base document upload
# path. Default: 10485760 (10 MiB).
EIVANTA_KNOWLEDGE_MAX_UPLOAD_BYTES=10485760
